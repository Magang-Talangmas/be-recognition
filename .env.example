ML_DETECT_CAMERA_ID=<YOUR_CAMERA_ID>
ML_DETECT_SIMILARITY_THRESHOLD=10
ML_DETECT_DEDUP_SECONDS=60
ML_REGISTER_URL=<YOUR_ML_REGISTER_URL>
ML_REGISTER_ENABLED=true
ML_REGISTER_TIMEOUT_MS=60000
ML_REMOVE_URL=<YOUR_ML_REMOVE_URL>
ML_VERIFY_FACE_URL=<YOUR_ML_VERIFY_FACE_URL>
