PORT=5000
NODE_ENV=development
ML_API_KEY=<YOUR_ML_API_KEY>
DATABASE_URL=<YOUR_DATABASE_URL>
DIRECT_URL=<YOUR_DIRECT_DATABASE_URL>
REDIS_URL=redis://localhost:6379
JWT_SECRET=<YOUR_JWT_SECRET>
AI_STREAM_BASE_URL=<YOUR_AI_STREAM_BASE_URL>
AI_STREAM_WHEP_URL=<YOUR_AI_STREAM_WHEP_URL>
AI_STREAM_URL=<YOUR_AI_STREAM_URL e.g. http://192.168.77.172:8000/api/v1/video_feed>
SUPABASE_URL=<YOUR_SUPABASE_URL>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_BUCKET=recognition
ML_DETECT_URL=<YOUR_ML_DETECT_URL>
