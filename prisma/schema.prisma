generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id             String       @id @default(cuid())
  employeeId     String       @unique
  name           String
  email          String?      @unique
  password       String?
  fcmToken       String?
  position       String?
  department     String?
  status         String       @default("Active")
  faceRegistered Boolean      @default(false)
  joinedAt       DateTime?
  photos         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attendances    Attendance[]

  @@index([employeeId])
  @@map("employees")
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Attendance {
  id                 String             @id @default(cuid())
  externalEventId    String?            @unique                  // event_id dari AI (idempotency key)
  employeeId         String?
  cameraId           String             @default("unknown")      // ID kamera, opsional dari AI
  eventType          String             @default("CHECK_IN")     // CHECK_IN | CHECK_OUT | START_BREAK | dll
  status             AttendanceStatus   @default(CHECKED_IN)
  similarity         Float?                                      // Confidence score ArcFace (0.0–1.0)
  timestamp          DateTime                                    // Waktu deteksi (detected_at dari AI)
  confirmationStatus ConfirmationStatus @default(PENDING)       // PENDING | CONFIRMED | REJECTED
  isLate             Boolean?           @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  employee           Employee?          @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([cameraId])
  @@index([timestamp])
  @@index([employeeId, timestamp])
  @@index([eventType])
  @@index([externalEventId])
  @@index([confirmationStatus])
  @@map("attendances")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(VIEWER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

enum Role {
  ADMIN
  VIEWER
}

model Camera {
  id        String   @id @default(cuid())
  cameraId  String   @unique
  name      String
  location  String?
  rtspUrl   String?  @unique
  isOnline  Boolean  @default(true)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cameraId])
  @@map("cameras")
}

enum AttendanceStatus {
  CHECKED_IN
  ON_BREAK
  TRACKING_PAUSE
  CHECKED_OUT
  UNKNOWN
}

model WorkSchedule {
  id               String   @id @default(cuid())
  scheduleCode     String   @unique
  name             String
  workDays         String[] // ["Senin", "Selasa", "Rabu", "Kamis", "Jumat"]
  checkInTime      String   // format "HH:mm"
  checkOutTime     String   // format "HH:mm"
  breakStartTime   String?  // format "HH:mm"
  breakEndTime     String?  // format "HH:mm"
  toleranceMinutes Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("work_schedules")
}
