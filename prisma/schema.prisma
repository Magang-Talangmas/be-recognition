generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Employee {
  id             String       @id @default(cuid())
  employeeId     String       @unique
  name           String
  email          String?      @unique
  password       String?
  fcmToken       String?
  position       String?
  department     String?
  status         String       @default("Active")
  faceRegistered Boolean      @default(false)
  scheduleId     String?
  joinedAt       DateTime?
  photos         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attendances    Attendance[]
  schedule       WorkSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("employees")
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Attendance {
  id                 String             @id @default(cuid())
  externalEventId    String?            @unique                  // event_id dari AI (idempotency key)
  employeeId         String?
  cameraId           String             @default("unknown")      // ID kamera, opsional dari AI
  eventType          String             @default("CHECK_IN")     // CHECK_IN | CHECK_OUT | START_BREAK | dll
  status             AttendanceStatus   @default(CHECKED_IN)
  similarity         Float?                                      // Confidence score ArcFace (0.0–1.0)
  timestamp          DateTime                                    // Waktu deteksi (detected_at dari AI)
  confirmationStatus ConfirmationStatus @default(PENDING)       // PENDING | CONFIRMED | REJECTED
  isLate             Boolean?           @default(false)
  photoUrl           String? // URL foto bukti check-in (mobile app)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  employee           Employee?          @relation(fields: [employeeId], references: [employeeId])

  notifications      Notification[]

  @@index([employeeId])
  @@index([cameraId])
  @@index([timestamp])
  @@index([employeeId, timestamp])
  @@index([eventType])
  @@index([externalEventId])
  @@index([confirmationStatus])
  @@map("attendances")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(VIEWER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

enum Role {
  ADMIN
  VIEWER
}

model Camera {
  id        String   @id @default(cuid())
  cameraId  String   @unique
  name      String
  location  String?
  rtspUrl   String?  @unique
  isOnline  Boolean  @default(true)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cameraId])
  @@map("cameras")
}

model RecognitionEvent {
  id         String   @id @default(cuid())
  employeeId String?            // null = Unknown (wajah tidak dikenal)
  cameraId   String             // CAM-xx (mengikuti pola Attendance.cameraId)
  confidence Float              // 0-100
  status     String   @default("Verified") // Verified | Unknown
  thumbnail  String?
  createdAt  DateTime @default(now())

  notifications Notification[]

  @@index([cameraId])
  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@map("recognition_events")
}

enum AttendanceStatus {
  CHECKED_IN
  ON_BREAK
  TRACKING_PAUSE
  CHECKED_OUT
  UNKNOWN
}

model WorkSchedule {
  id               String   @id @default(cuid())
  scheduleCode     String   @unique
  name             String
  workDays         String[] // ["Senin", "Selasa", "Rabu", "Kamis", "Jumat"]
  checkInTime      String   // format "HH:mm"
  checkOutTime     String   // format "HH:mm"
  breakStartTime   String?  // format "HH:mm"
  breakEndTime     String?  // format "HH:mm"
  toleranceMinutes Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employees        Employee[]

  @@map("work_schedules")
}

model Notification {
  id           String      @id @default(cuid())
  attendanceId String?
  employeeId   String? // denormalized "EMP-xxx" untuk notifikasi reminder tanpa attendance
  recognitionId String? // UUID dari recognition_events untuk notifikasi REQUIRE_CONFIRMATION
  type         String      @default("INFO")
  title        String
  description  String
  isRead       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  attendance   Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  recognition  RecognitionEvent? @relation(fields: [recognitionId], references: [id], onDelete: SetNull)

  @@index([attendanceId])
  @@index([employeeId])
  @@index([recognitionId])
  @@map("notifications")
}

model Settings {
  id                  String   @id @default("system")
  notifUnregistered   Boolean  @default(true)
  notifCctvOffline    Boolean  @default(true)
  notifMissingCheckIn Boolean  @default(true)
  trackPauseAuto      Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  @@map("settings")
}

model AttendancePermission {
  id         String   @id @default(cuid())
  employeeId String // denormalized "EMP-xxx"
  date       DateTime @db.Date
  type       String // Sakit | Izin | Cuti | Lainnya
  reason     String
  photoUrl   String? // URL bukti foto di Supabase Storage
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendance_permissions")
}

