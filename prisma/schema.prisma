generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id         String       @id @default(cuid())
  employeeId String       @unique
  name       String
  department String?
  position   String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attendances Attendance[]

  @@index([employeeId])
  @@map("employees")
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Attendance {
  id                 String             @id @default(cuid())
  externalEventId    String?            @unique                  // event_id dari AI (idempotency key)
  employeeId         String?
  cameraId           String             @default("unknown")      // ID kamera, opsional dari AI
  eventType          String             @default("CHECK_IN")     // CHECK_IN | CHECK_OUT | START_BREAK | dll
  status             AttendanceStatus   @default(CHECKED_IN)
  similarity         Float?                                      // Confidence score ArcFace (0.0–1.0)
  timestamp          DateTime                                    // Waktu deteksi (detected_at dari AI)
  confirmationStatus ConfirmationStatus @default(PENDING)       // PENDING | CONFIRMED | REJECTED
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  employee           Employee?          @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([cameraId])
  @@index([timestamp])
  @@index([employeeId, timestamp])
  @@index([eventType])
  @@index([externalEventId])
  @@index([confirmationStatus])
  @@map("attendances")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(VIEWER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

enum Role {
  ADMIN
  VIEWER
}

model Camera {
  id        String   @id @default(cuid())
  cameraId  String   @unique
  name      String
  location  String?
  isOnline  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cameraId])
  @@map("cameras")
}

enum AttendanceStatus {
  CHECKED_IN
  ON_BREAK
  TRACKING_PAUSE
  CHECKED_OUT
  UNKNOWN
}
